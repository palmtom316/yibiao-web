name: yibiao-web
services:
  app:
    build:
      context: /home/palmtom/projects/yibiao-web
      dockerfile: Dockerfile
      args:
        BUILD_COMMIT: development
      target: app
    cap_drop:
      - ALL
    cpus: 3
    depends_on:
      migrate:
        condition: service_completed_successfully
        required: true
    environment:
      DATABASE_URL: postgresql://yibiao:x@postgres:5432/yibiao_web
      JWT_SECRET: synthetic-compose-validation-secret-32-chars
      YIBIAO_DATA_DIR: /data
      YIBIAO_EXTERNAL_ENDPOINTS: ""
      YIBIAO_INTERNAL_ENDPOINTS: ""
      YIBIAO_OUTLINE_V2: "true"
      YIBIAO_PUBLIC_ORIGIN: https://localhost
    logging:
      driver: json-file
      options:
        max-file: "5"
        max-size: 10m
    mem_limit: "4294967296"
    networks:
      backend: null
      egress: null
    read_only: true
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    stop_grace_period: 45s
    tmpfs:
      - /tmp:size=1g,mode=1777
    volumes:
      - type: volume
        source: appdata
        target: /data
        volume: {}
  migrate:
    build:
      context: /home/palmtom/projects/yibiao-web
      dockerfile: Dockerfile
      target: migrate
    depends_on:
      postgres:
        condition: service_healthy
        required: true
    environment:
      DATABASE_URL: postgresql://yibiao:x@postgres:5432/yibiao_web
      JWT_SECRET: synthetic-compose-validation-secret-32-chars
      YIBIAO_DATA_DIR: /data
      YIBIAO_EXTERNAL_ENDPOINTS: ""
      YIBIAO_INTERNAL_ENDPOINTS: ""
      YIBIAO_OUTLINE_V2: "true"
      YIBIAO_PUBLIC_ORIGIN: https://localhost
    logging:
      driver: json-file
      options:
        max-file: "5"
        max-size: 10m
    networks:
      backend: null
    restart: 'no'
    volumes:
      - type: volume
        source: appdata
        target: /data
        volume: {}
  nginx:
    build:
      context: /home/palmtom/projects/yibiao-web
      dockerfile: Dockerfile
      args:
        VITE_BUILD_COMMIT: development
        VITE_SOURCE_REPOSITORY_URL: https://github.com/palmtom316/yibiao-web
      target: nginx
    depends_on:
      app:
        condition: service_healthy
        required: true
    logging:
      driver: json-file
      options:
        max-file: "5"
        max-size: 10m
    mem_limit: "268435456"
    networks:
      backend: null
      frontend: null
    ports:
      - mode: ingress
        target: 443
        published: "443"
        protocol: tcp
    restart: unless-stopped
    volumes:
      - type: bind
        source: /home/palmtom/projects/yibiao-web/deploy/certs
        target: /etc/nginx/certs
        read_only: true
        bind: {}
  postgres:
    environment:
      POSTGRES_DB: yibiao_web
      POSTGRES_PASSWORD: x
      POSTGRES_USER: yibiao
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U yibiao -d yibiao_web
      timeout: 3s
      interval: 5s
      retries: 30
    image: postgres:16-bookworm@sha256:bb3e1a57e5407e0a5280b4211980a5e537f4abd234a87014ac979849a78dd825
    logging:
      driver: json-file
      options:
        max-file: "5"
        max-size: 10m
    mem_limit: "2147483648"
    networks:
      backend: null
    restart: unless-stopped
    volumes:
      - type: volume
        source: pgdata
        target: /var/lib/postgresql/data
        volume: {}
networks:
  backend:
    name: yibiao-web_backend
    internal: true
  egress:
    name: yibiao-web_egress
  frontend:
    name: yibiao-web_frontend
volumes:
  appdata:
    name: yibiao-web_appdata
  pgdata:
    name: yibiao-web_pgdata
x-logging:
  driver: json-file
  options:
    max-file: "5"
    max-size: 10m
