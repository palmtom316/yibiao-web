# Copy the relevant values into server/.env and client/.env.
# Never commit real credentials.

DATABASE_URL=postgresql://yibiao:yibiao@127.0.0.1:5432/yibiao_web
# 必须替换为至少 32 位随机值；示例/占位值（如本行）会在服务启动时被拒绝。
JWT_SECRET=replace-with-at-least-32-random-characters
HOST=0.0.0.0
PORT=3000
YIBIAO_DATA_DIR=./data
VITE_API_BASE_URL=/api
VITE_SOURCE_REPOSITORY_URL=https://github.com/palmtom316/yibiao-web

# Docker Compose: URL-safe random password; only nginx exposes port 443.
POSTGRES_PASSWORD=replace-with-url-safe-random-password
TLS_CERT_DIR=./deploy/certs
YIBIAO_PUBLIC_ORIGIN=https://localhost
# Comma-separated approved base URLs. Empty lists deny all model/OCR outbound calls.
YIBIAO_INTERNAL_ENDPOINTS=
YIBIAO_EXTERNAL_ENDPOINTS=
BUILD_COMMIT=development
YIBIAO_OUTLINE_V2=true
