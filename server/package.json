{
  "name": "openbidkit-yibiao-web-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  },
  "description": "基于 OpenBidKit_Yibiao 二次开发的 Fastify + Prisma + PostgreSQL Web 后端",
  "author": "mark / yibiaoai; Web modifications by jdcome",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/jdcome/OpenBidKit-Yibiao-Web.git",
    "directory": "server"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node ../scripts/test.mjs",
    "test:integration": "node ../scripts/test.mjs --integration",
    "start": "tsx src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx src/db/seed.ts",
    "db:initialize": "node scripts/initialize.mjs",
    "db:baseline": "node scripts/baseline.mjs",
    "db:docs:update": "tsx scripts/update-builtin-docs.ts",
    "db:deploy": "prisma migrate deploy",
    "db:migrate-personnel": "tsx scripts/migrate-personnel.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@prisma/client": "^6.2.1",
    "adm-zip": "^0.5.16",
    "ajv": "8.17.1",
    "archiver": "7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cfb": "^1.2.2",
    "chardet": "^2.1.1",
    "cheerio": "^1.2.0",
    "docx": "^9.6.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "iconv-lite": "^0.7.2",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.2.0",
    "markdown-it-cjk-friendly": "^2.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "11.17.2",
    "mime-types": "^3.0.2",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.7.284",
    "playwright-core": "1.55.1",
    "sharp": "0.34.5",
    "tsx": "4.23.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typebox": "1.1.38",
    "undici": "^6.21.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/archiver": "6.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^24.10.0",
    "prisma": "^6.2.1",
    "typescript": "^5.9.2"
  }
}
